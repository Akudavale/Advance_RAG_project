# RAG Project Configuration Template
# Copy this file to .env and fill in your credentials

# ============================================
# LLM Provider Configuration
# ============================================

# Provider: azure, gemini, or openai
LLM_PROVIDER=azure

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Google Gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL_NAME=gemini-2.5-flash-preview-05-20

# OpenAI (direct)
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL_NAME=gpt-4

# ============================================
# PostgreSQL Configuration
# ============================================

# Enable/disable PostgreSQL persistence
ENABLE_POSTGRES=true

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DB_URL=postgresql://postgres:password@localhost:5432/rag_db

# Echo SQL statements (useful for debugging)
DB_ECHO=false

# Disable connection pooling (useful for development)
DB_POOL_DISABLED=false

# ============================================
# Redis Configuration
# ============================================

# Enable/disable Redis caching
ENABLE_REDIS=true

# Redis connection details
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis default TTL (time-to-live) in seconds
# Default 3600 = 1 hour
REDIS_DEFAULT_TTL=3600

# ============================================
# Embedding Configuration
# ============================================

EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=  # Leave empty for auto-detect, or specify cuda/cpu
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_DIR=.cache/embeddings
EMBEDDING_BATCH_SIZE=32

# ============================================
# Reranker Configuration
# ============================================

RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=  # Leave empty for auto-detect
USE_CROSS_ENCODER=true

# ============================================
# Vector Store Configuration
# ============================================

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_documents

# ============================================
# PDF Processing Configuration
# ============================================

PDF_CACHE_DIR=.cache/pdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
PDF_TABLE_EXTRACTION_ENABLED=true
PDF_TABLE_MIN_CELLS=6
PDF_TABLE_MAX_ROWS=60

# ============================================
# LLM Generation Configuration
# ============================================

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# ============================================
# Prompt Configuration
# ============================================

MAX_CONTEXT_LENGTH=8000
MAX_HISTORY_TURNS=5
MAX_CHARS_PER_DOC=1500
PROMPTS_DIR=src/prompts/templates

# ============================================
# Memory Configuration (PostgreSQL + Redis)
# ============================================

# Maximum tokens for conversation context
MAX_TOKEN_LIMIT=4000

# Maximum conversation turns to keep in memory
MAX_CONVERSATION_TURNS=50

# Number of recent messages to keep in Redis cache
MAX_RECENT_TURNS=10

# Token threshold for auto-summarization
SUMMARY_THRESHOLD_TOKENS=2000

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO
LOG_FILE=logs/rag.log
